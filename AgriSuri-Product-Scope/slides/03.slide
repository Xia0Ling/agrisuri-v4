  <Box style={{ position: 'absolute', left: 72, top: 0, width: 560, height: 720, justifyContent: 'center' }}>

    <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, fontWeight: 600, color: '#A4DA22', letterSpacing: 2.6 }}>THE PRODUCT</Text>
    <Text style={{ fontFamily: 'Georgia', fontSize: 62, fontWeight: 'bold', color: '#F5F8F2', lineHeight: 1.1, letterSpacing: -0.8, marginTop: 16 }}>What it is, and<br />what it is not</Text>
    <Box style={{ width: 88, height: 3, background: '#A4DA22', marginTop: 26, marginBottom: 24 }} />
    <Text style={{ fontFamily: 'Segoe UI', fontSize: 19, color: 'rgba(245,248,242,0.72)', lineHeight: 1.65, width: 480 }}>
      The field constraint that shaped every decision after it — and the boundary the product refuses to cross.
    </Text>

    <Box style={{ flexDirection: 'row', gap: 18, marginTop: 40 }}>
      <Box style={{ width: 3, background: '#A4DA22' }} />
      <Box style={{ flex: 1 }}>
        <Text style={{ fontFamily: 'Georgia', fontSize: 21, fontStyle: 'italic', color: '#F5F8F2', lineHeight: 1.55, width: 460 }}>
          A photo that fails a check is never turned into a diagnosis. It is sent back for a better shot.
        </Text>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.55)', marginTop: 12 }}>Design rule, enforced in code — not in copy</Text>
      </Box>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginTop: 40, borderTop: '1px solid rgba(245,248,242,0.22)', paddingTop: 16 }}>
