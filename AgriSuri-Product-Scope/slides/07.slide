<Slide style={{ width: 1280, height: 720, padding: '20px 72px 0px 72px', background: '#0B1F14', position: 'relative' }}>

  <Box style={{ height: 108, justifyContent: 'center' }}>
    <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, fontWeight: 600, color: '#A4DA22', letterSpacing: 2.4 }}>THE PIPELINE</Text>
    <Text style={{ fontFamily: 'Segoe UI', fontSize: 34, fontWeight: 700, color: '#F5F8F2', letterSpacing: -0.6, marginTop: 8 }}>Five gates before a diagnosis</Text>
  </Box>

  <Box style={{ height: 532 }}>

    <Box style={{ height: 44, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
      <Text style={{ fontFamily: 'Segoe UI', fontSize: 16, color: 'rgba(245,248,242,0.7)' }}>
        Cheap checks run first. The expensive model only sees what survives.
      </Text>
      <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.45)', letterSpacing: 1.2 }}>FOUR GATES · ONE CLASSIFIER</Text>
    </Box>

    <Box style={{ height: 250, flexDirection: 'row', alignItems: 'flex-start', marginTop: 18 }}>

      <Box style={{ width: 200, flexDirection: 'column' }}>
        <Box style={{ height: 190, padding: 16, background: 'rgba(245,248,242,0.05)', border: '1px solid rgba(245,248,242,0.18)', borderRadius: 10, justifyContent: 'flex-start' }}>
          <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: 'rgba(245,248,242,0.45)', letterSpacing: 1.4 }}>STEP 0</Text>
          <Box style={{ marginTop: 18 }}>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 19, fontWeight: 600, color: '#F5F8F2' }}>Quality</Text>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.58)', lineHeight: 1.55, marginTop: 8 }}>Brightness, clipping, focus and detail measured from the actual pixels.</Text>
          </Box>
        </Box>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: 'rgba(245,248,242,0.5)', letterSpacing: 1.4, marginTop: 12 }}>FAIL → RETAKE</Text>
      </Box>

      <Box style={{ width: 34, height: 190, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 18, color: 'rgba(245,248,242,0.35)' }}>→</Text>
      </Box>

      <Box style={{ width: 200, flexDirection: 'column' }}>
        <Box style={{ height: 190, padding: 16, background: 'rgba(245,248,242,0.05)', border: '1px solid rgba(245,248,242,0.18)', borderRadius: 10, justifyContent: 'flex-start' }}>
          <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: 'rgba(245,248,242,0.45)', letterSpacing: 1.4 }}>STEP 1</Text>
          <Box style={{ marginTop: 18 }}>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 19, fontWeight: 600, color: '#F5F8F2' }}>Framing</Text>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.58)', lineHeight: 1.55, marginTop: 8 }}>Is one leaf inside the guide, and is it big enough to read?</Text>
          </Box>
        </Box>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: 'rgba(245,248,242,0.5)', letterSpacing: 1.4, marginTop: 12 }}>FAIL → RETAKE</Text>
      </Box>

      <Box style={{ width: 34, height: 190, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 18, color: 'rgba(245,248,242,0.35)' }}>→</Text>
      </Box>

      <Box style={{ width: 200, flexDirection: 'column' }}>
        <Box style={{ height: 190, padding: 16, background: 'rgba(245,248,242,0.05)', border: '1px solid rgba(245,248,242,0.18)', borderRadius: 10, justifyContent: 'flex-start' }}>
          <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: 'rgba(245,248,242,0.45)', letterSpacing: 1.4 }}>GATE 2</Text>
          <Box style={{ marginTop: 18 }}>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 19, fontWeight: 600, color: '#F5F8F2' }}>Shape</Text>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.58)', lineHeight: 1.55, marginTop: 8 }}>Plant or leaf silhouette — versus a hand, a tool, soil or sky.</Text>
          </Box>
        </Box>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: 'rgba(245,248,242,0.5)', letterSpacing: 1.4, marginTop: 12 }}>FAIL → REJECTED</Text>
      </Box>

      <Box style={{ width: 34, height: 190, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 18, color: 'rgba(245,248,242,0.35)' }}>→</Text>
      </Box>

      <Box style={{ width: 200, flexDirection: 'column' }}>
        <Box style={{ height: 190, padding: 16, background: 'rgba(245,248,242,0.05)', border: '1px solid rgba(245,248,242,0.18)', borderRadius: 10, justifyContent: 'flex-start' }}>
          <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: 'rgba(245,248,242,0.45)', letterSpacing: 1.4 }}>GATE 3</Text>
          <Box style={{ marginTop: 18 }}>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 19, fontWeight: 600, color: '#F5F8F2' }}>Texture</Text>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.58)', lineHeight: 1.55, marginTop: 8 }}>Leaf surface — versus wall, floor, fabric or paper. A green wall is not a leaf.</Text>
          </Box>
        </Box>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: 'rgba(245,248,242,0.5)', letterSpacing: 1.4, marginTop: 12 }}>FAIL → REJECTED</Text>
      </Box>

      <Box style={{ width: 34, height: 190, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 18, color: '#A4DA22' }}>→</Text>
      </Box>

      <Box style={{ width: 200, flexDirection: 'column' }}>
        <Box style={{ height: 190, padding: 16, background: 'rgba(164,218,34,0.12)', border: '1px solid #A4DA22', borderRadius: 10, justifyContent: 'flex-start' }}>
          <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: '#A4DA22', letterSpacing: 1.4 }}>CLASSIFIER</Text>
          <Box style={{ marginTop: 18 }}>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 19, fontWeight: 600, color: '#F5F8F2' }}>Disease</Text>
            <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.7)', lineHeight: 1.55, marginTop: 8 }}>14 classes across tomato and palay, each with a healthy baseline.</Text>
          </Box>
        </Box>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 11, fontWeight: 600, color: '#A4DA22', letterSpacing: 1.4, marginTop: 12 }}>PASS → RESULT</Text>
      </Box>

    </Box>

    <Box style={{ height: 1, background: 'rgba(245,248,242,0.18)', marginTop: 24 }} />

    <Box style={{ flexDirection: 'row', paddingTop: 22 }}>
      <Box style={{ width: 348, paddingRight: 28 }}>
        <Text style={{ fontFamily: 'Georgia', fontSize: 17, fontWeight: 'bold', color: '#A4DA22' }}>01</Text>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 15, fontWeight: 600, color: '#F5F8F2', marginTop: 6 }}>A retake is not a scan</Text>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.58)', lineHeight: 1.6, marginTop: 6 }}>Nothing is saved and no model is called. The counter does not move.</Text>
      </Box>
      <Box style={{ width: 1, background: 'rgba(245,248,242,0.18)' }} />
      <Box style={{ width: 348, paddingLeft: 28, paddingRight: 28 }}>
        <Text style={{ fontFamily: 'Georgia', fontSize: 17, fontWeight: 'bold', color: '#A4DA22' }}>02</Text>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 15, fontWeight: 600, color: '#F5F8F2', marginTop: 6 }}>A rejection never advances</Text>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.58)', lineHeight: 1.6, marginTop: 6 }}>If the shape gate says "not a plant", texture and disease never run.</Text>
      </Box>
      <Box style={{ width: 1, background: 'rgba(245,248,242,0.18)' }} />
      <Box style={{ flex: 1, paddingLeft: 28 }}>
        <Text style={{ fontFamily: 'Georgia', fontSize: 17, fontWeight: 'bold', color: '#A4DA22' }}>03</Text>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 15, fontWeight: 600, color: '#F5F8F2', marginTop: 6 }}>Uncertain is never stored</Text>
        <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.58)', lineHeight: 1.6, marginTop: 6 }}>Below 0.50 confidence the result is labelled uncertain and excluded from history.</Text>
      </Box>
    </Box>

  </Box>

  <Box style={{ height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', paddingTop: 16, borderTop: '1px solid rgba(245,248,242,0.16)' }}>
    <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.45)' }}>AgriSuri PH · Product Scope</Text>
    <Text style={{ fontFamily: 'Segoe UI', fontSize: 13, color: 'rgba(245,248,242,0.45)' }}>07 / 19</Text>
  </Box>
</Slide>
